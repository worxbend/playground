# Copy to .env beside docker-compose.yml and fill in. .env is gitignored.

# --- PostgreSQL -----------------------------------------------------------
POSTGRES_DB=observatory
POSTGRES_USER=observatory
# Generate with: openssl rand -base64 32
POSTGRES_PASSWORD=change-me

# --- ferrite (web) --------------------------------------------------------
# Play refuses to start in prod mode without this.
# Generate with: openssl rand -base64 48
APPLICATION_SECRET=change-me
# Comma-separated. Must include the hostname you actually browse to.
ALLOWED_HOSTS=localhost,127.0.0.1,observatory.home.arpa

# --- wolfram: ingestion authentication ------------------------------------
# Every /v1 operation requires a JWT bearer token with the `events:write` scope.
# Compose refuses to start without a secret: an ingestion endpoint that is open
# because a variable was forgotten is the failure this guard exists to prevent.
# Generate with: openssl rand -base64 48   (HS256 needs at least 32 characters)
AUTH_SECRET=change-me-to-at-least-32-characters-long
AUTH_ALGORITHM=HS256
# Set false to run without authentication. Deliberately explicit — see above.
AUTH_ENABLED=true

# --- cobalt: admin API authentication -------------------------------------
# Every /admin route requires a JWT bearer token. Reads (`GET /admin/dlq/records`,
# `GET /admin/consumer`) need the `admin:read` scope; the routes that change the
# pipeline need `admin:write` — including the one that permanently skips every
# unconsumed event. /metrics and /health/live|ready stay open, because Prometheus
# and the container healthcheck cannot hold a token.
#
# A SEPARATE secret from wolfram's AUTH_SECRET on purpose: both services read this
# file, so sharing the variable would make one key mint both ingestion and admin
# tokens. Compose refuses to start without it.
# Generate with: openssl rand -base64 48   (HS256 needs at least 32 characters)
ADMIN_AUTH_SECRET=change-me-to-a-different-at-least-32-character-secret
ADMIN_AUTH_ALGORITHM=HS256
# Set false to run the admin API open. Deliberately explicit — see above.
ADMIN_AUTH_ENABLED=true

# --- cobalt: DLQ replay ---------------------------------------------------
# Whether POST /admin/dlq/replay may COMMIT. Set false to leave the operator the
# read endpoints and dry runs while forbidding the write. See docs/services/cobalt.md.
REPLAY_ENABLED=true
# Ceiling on records one request may list or replay. A request above it is refused,
# never silently clamped.
REPLAY_MAX_RECORDS=200
# How many times any one record may ever be replayed — the bound on a poison loop.
REPLAY_MAX_ATTEMPTS=3

# --- Observability --------------------------------------------------------
# Tags every meter and span. Set it to the image tag sbt built, so a rollout is visible in the dashboards.
SERVICE_VERSION=0.1.0-SNAPSHOT
OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4317
OTEL_TRACES_SAMPLER=parentbased_traceidratio
OTEL_TRACES_SAMPLER_ARG=0.1
LOG_LEVEL=INFO

# --- Grafana --------------------------------------------------------------
GRAFANA_ADMIN_PASSWORD=change-me
