<?xml version="1.0" encoding="UTF-8"?>
<!--
  cobalt's logging configuration (ADR-0000 section 7.3).

  This file has to exist. `modules/observability` ships the shared JSON configuration as an *includable* fragment
  rather than as a `logback.xml`, precisely so that a library jar cannot auto-configure its consumers — which means
  nothing includes it unless a service does so by name. Without this file logback finds no configuration at all and
  falls back to `BasicConfigurator`: the root logger sits at DEBUG and every line is unstructured text, so
  `pekko.loggers = [Slf4jLogger]` in application.conf routes Pekko's output into a sink that then loses the
  structure the routing existed to preserve, and LOG_LEVEL controls nothing.

  Levels come from LOG_LEVEL / LOG_APP_LEVEL, read by the included fragment.
-->
<configuration>
  <include resource="io/kzonix/observability/logback-json.xml"/>
</configuration>
